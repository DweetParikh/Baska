{
  "name": "baska-v2",
  "private": true,
  "scripts": {
    "test": "ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts",
    "test:keeper": "ts-mocha -p ./tsconfig.json keeper/test/**/*.ts",
    "keeper": "ts-node -P ./tsconfig.json keeper/src/index.ts",
    "api:generate": "prisma generate --config ./api/prisma.config.ts",
    "api:migration-sql": "prisma migrate diff --config ./api/prisma.config.ts --from-empty --to-schema ./api/prisma/schema.prisma --script",
    "api:dev-db": "ts-node -P ./tsconfig.json api/scripts/dev-db.ts",
    "api": "ts-node -P ./tsconfig.json api/src/index.ts",
    "seed": "ts-node -P ./tsconfig.json scripts/seed-devnet.ts",
    "oracle": "ts-node -P ./tsconfig.json scripts/price-updater.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "chai": "^4.3.4",
    "mocha": "^10.0.0",
    "prisma": "7.10.1",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
